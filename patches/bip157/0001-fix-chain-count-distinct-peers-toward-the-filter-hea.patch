From 220ab7d0d38303385bd2357b3a455b4e5c99a063 Mon Sep 17 00:00:00 2001
From: Dario Gabriel Lipicar <dario@status.im>
Date: Sat, 10 Oct 2026 22:32:06 -0300
Subject: [PATCH 1/4] fix(chain): count distinct peers toward the filter-header
 quorum

A peer repeating the pending batch took it out of the pending slot, so its
next copy counted again: one peer sending the same batch three times met a
quorum of two, and two peers met three. The quorum now counts each peer once,
and a repeat leaves the pending batch in place.

A peer also forwarded every cfheaders message it received. Batches it was not
asked for are now dropped with an UnsolicitedMessage warning.
---
 src/chain/chain.rs  | 56 +++++++++++++++++++++++++++++++++++++++++++--
 src/chain/mod.rs    | 17 ++++++++------
 src/network/peer.rs | 45 ++++++++++++++++++++++++++++++++++++
 3 files changed, 109 insertions(+), 9 deletions(-)

diff --git a/src/chain/chain.rs b/src/chain/chain.rs
index 76088ee..1436236 100644
--- a/src/chain/chain.rs
+++ b/src/chain/chain.rs
@@ -213,6 +213,8 @@ impl Chain {
         match self.request_state.pending_batch.take() {
             Some((id, pending)) => {
                 if peer_id.eq(&id) {
+                    // A repeat from the same peer adds no vote; the batch stays pending.
+                    self.request_state.pending_batch = Some((id, pending));
                     return Ok(CFHeaderChanges::AddedToQueue);
                 }
                 if pending.ne(&batch) {
@@ -220,7 +222,7 @@ impl Chain {
                     self.request_state.agreement_state.reset_agreements();
                     Ok(CFHeaderChanges::Conflict)
                 } else {
-                    self.request_state.agreement_state.got_agreement();
+                    self.request_state.agreement_state.got_agreement(peer_id);
                     if self.request_state.agreement_state.enough_agree() {
                         self.request_state.agreement_state.reset_agreements();
                         self.push_cf_header_batch(batch, request.stop_hash);
@@ -232,7 +234,7 @@ impl Chain {
                 }
             }
             None => {
-                self.request_state.agreement_state.got_agreement();
+                self.request_state.agreement_state.got_agreement(peer_id);
                 if self.request_state.agreement_state.enough_agree() {
                     self.request_state.agreement_state.reset_agreements();
                     self.push_cf_header_batch(batch, request.stop_hash);
@@ -1081,4 +1083,54 @@ mod tests {
         assert_eq!(cf_header_sync_res.unwrap(), CFHeaderChanges::AddedToQueue);
         assert!(!chain.is_cf_headers_synced());
     }
+
+    fn cf_headers(scenario: &ChainScenario, filter_hashes: Vec<FilterHash>) -> CFHeaders {
+        CFHeaders {
+            filter_type: 0x00,
+            stop_hash: scenario.last_block_hash(),
+            previous_filter_header: scenario.prev_header(),
+            filter_hashes,
+        }
+    }
+
+    #[tokio::test]
+    async fn one_peer_repeating_a_batch_is_one_vote() {
+        let mut chain = new_regtest(base_block(), 2);
+        let scenario = load_scenario();
+        assert!(chain.sync_chain(scenario.most_work_headers()).is_ok());
+        chain.next_cf_header_message();
+        let stale_hash = scenario.stale_chain[0].filter_hash();
+        let mut forged_hashes = scenario.n_most_work_filter_hashes(4);
+        forged_hashes.push(stale_hash);
+        let forged = cf_headers(&scenario, forged_hashes);
+        for _ in 0..5 {
+            let changes = chain.sync_cf_headers(7.into(), forged.clone()).unwrap();
+            assert_eq!(changes, CFHeaderChanges::AddedToQueue);
+        }
+        assert!(!chain.is_cf_headers_synced());
+        let tip = scenario.last_block_hash();
+        assert_ne!(chain.header_chain.filter_hash(tip), Some(stale_hash));
+        // A second peer with the real batch disagrees: a conflict, never the forged batch.
+        let honest = cf_headers(&scenario, scenario.n_most_work_filter_hashes(5));
+        let changes = chain.sync_cf_headers(8.into(), honest).unwrap();
+        assert_eq!(changes, CFHeaderChanges::Conflict);
+        assert!(!chain.is_cf_headers_synced());
+    }
+
+    #[tokio::test]
+    async fn two_peers_cannot_meet_a_quorum_of_three() {
+        let mut chain = new_regtest(base_block(), 3);
+        let scenario = load_scenario();
+        assert!(chain.sync_chain(scenario.most_work_headers()).is_ok());
+        chain.next_cf_header_message();
+        let batch = cf_headers(&scenario, scenario.n_most_work_filter_hashes(5));
+        for peer in [1, 2, 2, 1] {
+            let changes = chain.sync_cf_headers(peer.into(), batch.clone()).unwrap();
+            assert_eq!(changes, CFHeaderChanges::AddedToQueue);
+        }
+        assert!(!chain.is_cf_headers_synced());
+        let changes = chain.sync_cf_headers(3.into(), batch).unwrap();
+        assert_eq!(changes, CFHeaderChanges::Extended);
+        assert!(chain.is_cf_headers_synced());
+    }
 }
diff --git a/src/chain/mod.rs b/src/chain/mod.rs
index fd66cb0..947b96e 100644
--- a/src/chain/mod.rs
+++ b/src/chain/mod.rs
@@ -154,30 +154,33 @@ pub(crate) struct FilterHeaderRequest {
     pub expected_prev_filter_header: Option<FilterHeader>,
 }
 
-#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[derive(Debug, Clone, PartialEq, Eq)]
 pub(crate) struct FilterHeaderAgreements {
-    current: u8,
+    // The distinct peers that sent the pending batch: a peer repeating itself is one vote.
+    agreed: Vec<PeerId>,
     required: u8,
 }
 
 impl FilterHeaderAgreements {
     pub(crate) fn new(required: u8) -> Self {
         Self {
-            current: 0,
+            agreed: Vec::new(),
             required,
         }
     }
 
-    pub(crate) fn got_agreement(&mut self) {
-        self.current += 1;
+    pub(crate) fn got_agreement(&mut self, peer_id: PeerId) {
+        if !self.agreed.contains(&peer_id) {
+            self.agreed.push(peer_id);
+        }
     }
 
     pub(crate) fn enough_agree(&self) -> bool {
-        self.current.ge(&self.required)
+        self.agreed.len() >= usize::from(self.required)
     }
 
     pub(crate) fn reset_agreements(&mut self) {
-        self.current = 0;
+        self.agreed.clear();
     }
 }
 
diff --git a/src/network/peer.rs b/src/network/peer.rs
index eeb44b5..551211f 100644
--- a/src/network/peer.rs
+++ b/src/network/peer.rs
@@ -36,6 +36,27 @@ use super::{
 const LOOP_TIMEOUT: Duration = Duration::from_millis(500);
 const V2_HANDSHAKE_TIMEOUT: Duration = Duration::from_secs(4);
 
+// Filter header requests sent to this peer and not yet answered.
+#[derive(Debug, Default, Clone, Copy)]
+struct CfHeaderRequests(u32);
+
+impl CfHeaderRequests {
+    fn ask(&mut self) {
+        self.0 = self.0.saturating_add(1);
+    }
+
+    // False for a batch nobody asked this peer for.
+    fn answer(&mut self) -> bool {
+        match self.0.checked_sub(1) {
+            Some(left) => {
+                self.0 = left;
+                true
+            }
+            None => false,
+        }
+    }
+}
+
 pub(crate) struct Peer {
     nonce: PeerId,
     source: Record,
@@ -49,6 +70,7 @@ pub(crate) struct Peer {
     message_state: MessageState,
     tx_queue: Arc<Mutex<BroadcastQueue>>,
     relay_policy: RelayPolicy,
+    cf_header_requests: CfHeaderRequests,
 }
 
 impl Peer {
@@ -79,6 +101,7 @@ impl Peer {
             timeout_config,
             message_state: MessageState::new(timeout_config.response_timeout),
             tx_queue,
+            cf_header_requests: CfHeaderRequests::default(),
         }
     }
 
@@ -236,6 +259,11 @@ impl Peer {
                 Ok(())
             }
             ReaderMessage::FilterHeaders(cf_headers) => {
+                // Unsolicited batches are dropped, so a peer cannot answer more than it was asked.
+                if !self.cf_header_requests.answer() {
+                    self.dialog.send_warning(Warning::UnsolicitedMessage);
+                    return Ok(());
+                }
                 self.main_thread_sender
                     .send(PeerThreadMessage {
                         nonce: self.nonce,
@@ -446,6 +474,7 @@ impl Peer {
                 self.write_bytes(writer, message).await?;
             }
             MainThreadMessage::GetFilterHeaders(config) => {
+                self.cf_header_requests.ask();
                 let message = message_generator.serialize(NetworkMessage::GetCFHeaders(config));
                 self.write_bytes(writer, message).await?;
             }
@@ -527,3 +556,19 @@ impl Peer {
         }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::CfHeaderRequests;
+
+    #[test]
+    fn only_requested_filter_headers_are_answers() {
+        let mut requests = CfHeaderRequests::default();
+        assert!(!requests.answer());
+        requests.ask();
+        requests.ask();
+        assert!(requests.answer());
+        assert!(requests.answer());
+        assert!(!requests.answer());
+    }
+}
