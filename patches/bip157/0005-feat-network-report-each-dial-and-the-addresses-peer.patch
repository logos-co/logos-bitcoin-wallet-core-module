+            DialOutcome::TimedOut => write!(f, "timed out"),
+            DialOutcome::Refused => write!(f, "refused"),
+            DialOutcome::Unreachable => write!(f, "unreachable"),
+            DialOutcome::Local => write!(f, "failed on this side"),
