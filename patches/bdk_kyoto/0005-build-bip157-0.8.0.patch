From 4c37f9578578e5b0b359559adb8ac13f21e0d1aa Mon Sep 17 00:00:00 2001
From: Dario Gabriel Lipicar <dario@status.im>
Date: Mon, 26 Oct 2026 16:45:13 -0300
Subject: [PATCH 5/5] build: bip157 0.8.0

bip157 0.8.0 bounds the warning channel and replaces Info::Progress with
the heights reached (NewChainHeight, CFHeadersAdded, FilterAdded).
LoggingSubscribers hands out the bounded warning receiver, and the
examples log the new heights.
---
 Cargo.toml          |  2 +-
 Cargo.toml.orig     |  2 +-
 examples/example.rs | 11 +++++++----
 examples/multi.rs   | 11 +++++++----
 src/lib.rs          |  2 +-
 5 files changed, 17 insertions(+), 11 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index dc08ba8..4eaf2bf 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -55,7 +55,7 @@ path = "tests/client.rs"
 version = "3"
 
 [dependencies.bip157]
-version = "0.7.0"
+version = "0.8.0"
 
 [dev-dependencies.anyhow]
 version = "1.0"
diff --git a/Cargo.toml.orig b/Cargo.toml.orig
index 7b2637c..49547ca 100644
--- a/Cargo.toml.orig
+++ b/Cargo.toml.orig
@@ -13,7 +13,7 @@ rust-version = "1.85.0"
 
 [dependencies]
 bdk_wallet = "3"
-bip157 = { version = "0.7.0" }
+bip157 = { version = "0.8.0" }
 
 [dev-dependencies]
 tokio = { version = "1", features = ["full"], default-features = false }
diff --git a/examples/example.rs b/examples/example.rs
index c33be41..f9a013d 100644
--- a/examples/example.rs
+++ b/examples/example.rs
@@ -1,5 +1,5 @@
 use bdk_kyoto::builder::{Builder, BuilderExt};
-use bdk_kyoto::{HashCheckpoint, Info, Receiver, SyncConfig, UnboundedReceiver, Warning};
+use bdk_kyoto::{HashCheckpoint, Info, Receiver, SyncConfig, Warning};
 use bdk_wallet::bitcoin::Network;
 use bdk_wallet::{KeychainKind, Wallet};
 use tokio::select;
@@ -13,15 +13,18 @@ const USER_SCRIPTS_USED: u32 = 1_000;
 
 async fn traces(
     mut info_subscriber: Receiver<Info>,
-    mut warning_subscriber: UnboundedReceiver<Warning>,
+    mut warning_subscriber: Receiver<Warning>,
 ) {
     loop {
         select! {
             info = info_subscriber.recv() => {
                 if let Some(info) = info {
                     match info {
-                        Info::Progress(p) => {
-                            tracing::info!("chain height: {}, filter download progress: {}%", p.chain_height(), p.percentage_complete());
+                        Info::NewChainHeight(height) => {
+                            tracing::info!("chain height: {height}");
+                        },
+                        Info::CFHeadersAdded(height) => {
+                            tracing::info!("filter headers to height: {height}");
                         },
                         Info::BlockReceived(b) => {
                             tracing::info!("downloaded block: {b}");
