 use bdk_wallet::{KeychainKind, Wallet};
@@ -15,15 +15,18 @@ const NETWORK: Network = Network::Signet;
 
 async fn traces(
     mut info_subscriber: Receiver<Info>,
-    mut warning_subscriber: UnboundedReceiver<Warning>,
+    mut warning_subscriber: Receiver<Warning>,
 ) {
     loop {
         select! {
             info = info_subscriber.recv() => {
                 if let Some(info) = info {
                     match info {
-                        Info::Progress(p) => {
-                            tracing::info!("chain height: {}, filter download progress: {}%", p.chain_height(), p.percentage_complete());
+                        Info::NewChainHeight(height) => {
+                            tracing::info!("chain height: {height}");
+                        },
+                        Info::CFHeadersAdded(height) => {
+                            tracing::info!("filter headers to height: {height}");
                         },
                         Info::BlockReceived(b) => {
                             tracing::info!("downloaded block: {b}");
diff --git a/src/lib.rs b/src/lib.rs
index f3013b7..11606ce 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -104,7 +104,7 @@ pub struct LoggingSubscribers {
     /// Receive informational messages as the node runs.
     pub info_subscriber: Receiver<Info>,
     /// Receive warnings from the node as it runs.
-    pub warning_subscriber: UnboundedReceiver<Warning>,
+    pub warning_subscriber: Receiver<Warning>,
 }
 
 /// A client and associated structs to send and receive events to and from a node process.
