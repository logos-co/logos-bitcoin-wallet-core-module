From 3587d7f08b42cfc101c992309dda01d5aa1b40c3 Mon Sep 17 00:00:00 2001
From: Dario Gabriel Lipicar <dario@status.im>
Date: Sun, 11 Oct 2026 05:32:34 -0300
Subject: [PATCH 1/4] fix(sync): apply matched blocks oldest first

A spend is relevant to the IndexedTxGraph only once the output it spends
is indexed. Draining queued blocks from the end applied a spending block
before the block that funded it, and the spend was dropped from the
update; a wallet restored this way missed its own spends.
---
 src/lib.rs | 48 +++++++++++++++++++++++++++++-------------------
 1 file changed, 29 insertions(+), 19 deletions(-)

diff --git a/src/lib.rs b/src/lib.rs
index feac7fa..c20f481 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -253,8 +253,8 @@ pub struct UpdateSubscriber<W: Wallets> {
     requester: Requester,
     // channel receiver
     receiver: UnboundedReceiver<Event>,
-    // queued blocks to fetch
-    queued_blocks: Vec<BlockHash>,
+    // queued blocks to fetch, with their heights
+    queued_blocks: Vec<(u32, BlockHash)>,
     // queued scripts to check filters
     spk_cache: HashSet<ScriptBuf>,
     // processes events for the wallet.
@@ -323,7 +323,7 @@ impl<W: Wallets> UpdateSubscriber<W> {
                 Event::IndexedFilter(filter) => {
                     let block_hash = filter.block_hash();
                     if filter.contains_any(self.spk_cache.iter()) {
-                        self.queued_blocks.push(block_hash);
+                        self.queued_blocks.push((filter.height(), block_hash));
                     }
                 }
                 Event::ChainUpdate(changeset) => {
@@ -340,22 +340,7 @@ impl<W: Wallets> UpdateSubscriber<W> {
                     tip: _,
                     recent_history: _,
                 }) => {
-                    while let Some(&hash) = self.queued_blocks.last() {
-                        let block = self
-                            .requester
-                            .get_block(hash)
-                            .await
-                            .map_err(|_| UpdateError::NodeStopped)?;
-                        if let Some(single) = self.single_update_builder.as_mut() {
-                            single.apply_block_event(&block);
-                        }
-                        if let Some(multiple) = self.multiple_updates_builder.as_mut() {
-                            for builder in multiple.values_mut() {
-                                builder.apply_block_event(&block);
-                            }
-                        }
-                        self.queued_blocks.pop();
-                    }
+                    self.apply_queued_blocks().await?;
                     if let Some(single) = self.single_update_builder.as_mut() {
                         self.spk_cache
                             .extend(single.peek_script_to_keychain_lookahead());
@@ -374,6 +359,31 @@ impl<W: Wallets> UpdateSubscriber<W> {
     }
 }
 
+impl<W: Wallets> UpdateSubscriber<W> {
+    // Oldest first: a spend is relevant to the graph only once the output it spends is indexed,
+    // so a block applied before the block that funds it would lose the spend.
+    async fn apply_queued_blocks(&mut self) -> Result<(), UpdateError> {
+        self.queued_blocks.sort_by_key(|(height, _)| *height);
+        while let Some(&(_, hash)) = self.queued_blocks.first() {
+            let block = self
+                .requester
+                .get_block(hash)
+                .await
+                .map_err(|_| UpdateError::NodeStopped)?;
+            if let Some(single) = self.single_update_builder.as_mut() {
+                single.apply_block_event(&block);
+            }
+            if let Some(multiple) = self.multiple_updates_builder.as_mut() {
+                for builder in multiple.values_mut() {
+                    builder.apply_block_event(&block);
+                }
+            }
+            self.queued_blocks.remove(0);
+        }
+        Ok(())
+    }
+}
+
 impl UpdateSubscriber<wallets::Single> {
     /// Return the most recent [`Update`] for a wallet once it has synced to the network's tip.
     /// This may take a significant portion of time during wallet recoveries or dormant wallets.
