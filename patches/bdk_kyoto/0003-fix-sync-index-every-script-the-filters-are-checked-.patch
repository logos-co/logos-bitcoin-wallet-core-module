From 50d7f4a145f3f43c627368f00aebb31101d8aa1d Mon Sep 17 00:00:00 2001
From: Dario Gabriel Lipicar <dario@status.im>
Date: Sun, 11 Oct 2026 05:51:34 -0300
Subject: [PATCH 3/3] fix(sync): index every script the filters are checked
 against

A recovery or a sync with a lookahead checks filters against scripts up
to the revealed index plus that lookahead, which can reach past the
index's own lookahead. A block matched by one of those scripts was
fetched, and its transaction then read as irrelevant to the graph, so
the update dropped it. The index now derives every script the policy
peeks.
---
 src/lib.rs | 25 +++++++++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/src/lib.rs b/src/lib.rs
index 59ca38c..de9fb19 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -278,7 +278,8 @@ impl<W: Wallets> UpdateSubscriber<W> {
         cp: CheckPoint,
         graph: IndexedTxGraph<ConfirmationBlockTime, KeychainTxOutIndex<KeychainKind>>,
     ) -> UpdateSubscriber<wallets::Single> {
-        let update_builder = UpdateBuilder::new(cp, graph);
+        let mut update_builder = UpdateBuilder::new(cp, graph);
+        update_builder.index_to_policy(policy);
         let spk_cache = update_builder.peek_scripts_from_policy(policy);
         UpdateSubscriber {
             requester,
@@ -310,7 +311,8 @@ impl<W: Wallets> UpdateSubscriber<W> {
         let mut update_map = BTreeMap::new();
         let mut spk_cache = HashSet::new();
         for wallet in wallet_iter {
-            let update_builder = UpdateBuilder::new(wallet.2, wallet.3);
+            let mut update_builder = UpdateBuilder::new(wallet.2, wallet.3);
+            update_builder.index_to_policy(wallet.1);
             spk_cache.extend(update_builder.peek_scripts_from_policy(wallet.1));
             update_map.insert(wallet.0, update_builder);
         }
@@ -496,6 +498,25 @@ impl UpdateBuilder {
         }
     }
 
+    // Filters are checked against every script the policy peeks, which can reach past the index's
+    // own lookahead: the index derives them all, or a matched block's transaction reads as irrelevant.
+    fn index_to_policy(&mut self, policy: SyncPolicy) {
+        let n = match policy {
+            SyncPolicy::Recovery {
+                used_script_index, ..
+            } => used_script_index,
+            SyncPolicy::SyncFromLast { lookahead: Some(n) } => n,
+            _ => return,
+        };
+        let revealed = self.graph.index.last_revealed_indices();
+        for keychain in [KeychainKind::External, KeychainKind::Internal] {
+            let top = revealed.get(&keychain).copied().unwrap_or(0).saturating_add(n);
+            if let Some(top) = top.checked_sub(1) {
+                let _ = self.graph.index.lookahead_to_target(keychain, top);
+            }
+        }
+    }
+
     fn apply_block_event(&mut self, block: &IndexedBlock) {
         let height = block.height;
         let block = &block.block;
